{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist-test",
    "rootDir": "./assets/scripts",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "assets/scripts/core/**/*.ts",
    "assets/scripts/net/**/*.ts"
  ]
}
